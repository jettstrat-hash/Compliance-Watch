# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite:///./compliancewatch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/compliancewatch

# Regulations.gov API (free key at https://open.gsa.gov/api/regulationsgov/)
REGULATIONS_GOV_API_KEY=

# SendGrid (email alerts)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
SENDGRID_FROM_NAME=ComplianceWatch

# Stripe (subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App settings
APP_ENV=development
LOG_LEVEL=INFO
INGEST_LOOKBACK_DAYS=1
